# ── SATUSEHAT Sandbox credentials ──
# Copy this file to ".env" (same folder) and paste your OWN sandbox codes.
# Get them at: satusehat.kemkes.go.id/platform  ->  Sandbox env  ->  "Kode Akses API"
# NEVER commit the real .env or share CLIENT_SECRET publicly.
#
# Leave the values empty (or as placeholders) to run in MOCK mode:
# the backend returns realistic FHIR-shaped responses so the demo works
# fully offline. Fill them in for a genuine LIVE sandbox connection.

SATUSEHAT_ORG_ID=paste_your_org_id_here
SATUSEHAT_CLIENT_ID=paste_your_client_id_here
SATUSEHAT_CLIENT_SECRET=paste_your_client_secret_here

# Sandbox base URL (leave as-is). Production would be a different host.
SATUSEHAT_BASE=https://api-satusehat-stg.dto.kemkes.go.id

# Force mock even when creds are present? (1/true = always mock)
SATUSEHAT_MOCK=

# ── Optional: actors for the radiology chain (defaults = SATUSEHAT sandbox dummies) ──
# SATUSEHAT_PATIENT_ID=P02478375538        # used when the page sends no valid 16-digit NIK
# SATUSEHAT_PRACTITIONER_ID=10009880728    # requester / performer
# SATUSEHAT_LOCATION_ID=                   # empty = find or create "Instalasi Radiologi"
